NVIDIA_TIMEOUT_MS=60000

# Langfuse
# Local Compose: self-hosted (below). Railway demo: Langfuse Cloud —
#   LANGFUSE_BASE_URL=https://cloud.langfuse.com
#   LANGFUSE_UI_URL=https://cloud.langfuse.com
#   + Cloud project public/secret keys (never commit real keys)
LANGFUSE_PORT=3100
LANGFUSE_PUBLIC_KEY=pk-lf-zamp-local
LANGFUSE_SECRET_KEY=sk-lf-zamp-local
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_UI_URL=http://localhost:3100
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_NEXTAUTH_URL=http://localhost:3100
LANGFUSE_INIT_ORG_ID=zamp-org
LANGFUSE_INIT_ORG_NAME=Zamp
LANGFUSE_INIT_PROJECT_ID=zamp-project
LANGFUSE_INIT_PROJECT_NAME=Zamp Local
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# Frontend
